{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ 生成活动文件",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++17",
                "-g",
                "-I${workspaceFolder}/include",
                "-I/opt/homebrew/include",
                "-L/opt/homebrew/lib",
                "${workspaceFolder}/src/glad.c",
                "${workspaceFolder}/main.cpp",
                "-lglfw",
                "-framework",
                "OpenGL",
                "-framework",
                "Cocoa",
                "-framework",
                "IOKit",
                "-framework",
                "CoreVideo",
                "-o",
                "${workspaceFolder}/build/build_main"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}